# Copy this file to ".env" and fill in your own values.
# The ".env" file is git-ignored — never commit real keys.

# --- Supabase (frontend, safe to expose: anon key is public-by-design) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Tongyi / DashScope (BACKEND ONLY — used by Supabase Edge Functions in Phase 2) ---
# Do NOT prefix with VITE_ and do NOT put this in the frontend.
# Set it as a Supabase secret instead:  supabase secrets set DASHSCOPE_API_KEY=sk-xxxx
# DASHSCOPE_API_KEY=sk-xxxx
